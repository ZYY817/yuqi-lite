<Application x:Class="MemoryKeeper.Shell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MemoryKeeper.Modules.Shared;component/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>

            <!-- 极简滚动条：同时设 Width 与 MinWidth -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="4"/>
                <Setter Property="MinWidth" Value="4"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Margin" Value="6,4,0,4"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent" Width="4">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#C6C9D2" CornerRadius="2" Width="4"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
